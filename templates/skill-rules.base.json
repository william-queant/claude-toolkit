{
	"skills": {
		"ct-systematic-debugging": {
			"description": "Four-phase debugging with root cause analysis",
			"priority": 9,
			"triggers": {
				"keywords": ["bug", "debug", "fix", "error", "issue", "broken", "crash", "failing"],
				"keywordPatterns": [
					"\\bbug\\b",
					"\\bfix\\b",
					"\\berror\\b",
					"\\bissue\\b",
					"doesn't work",
					"not working"
				],
				"intentPatterns": [
					"(?:fix|debug|resolve|investigate).*(?:bug|error|issue|problem)",
					"(?:why).*(?:not working|broken|failing|crash)",
					"(?:something).*(?:wrong|broken)"
				]
			},
			"excludePatterns": ["fix typo", "fix formatting", "fix lint"]
		},
		"ct-testing-patterns": {
			"description": "Test-driven development workflow and patterns",
			"priority": 9,
			"triggers": {
				"keywords": ["test", "spec", "tdd", "mock", "factory", "vitest", "jest"],
				"keywordPatterns": ["\\btest(?:s|ing)?\\b", "\\bspec\\b", "unit test"],
				"pathPatterns": [
					"**/*.test.ts",
					"**/*.test.tsx",
					"**/*.spec.ts",
					"**/test-utils/**",
					"**/__mocks__/**"
				],
				"intentPatterns": [
					"(?:write|add|create|fix).*(?:test|spec)",
					"(?:test|spec).*(?:for|of|the)",
					"(?:red.green.refactor|tdd)"
				],
				"contentPatterns": ["describe\\(", "it\\(", "expect\\(", "vi\\.mock", "jest\\.mock"]
			}
		},
		"ct-typescript-conventions": {
			"description": "TypeScript strict mode, conventions, and TS7 compiler selection",
			"priority": 5,
			"triggers": {
				"keywords": [
					"typescript",
					"type",
					"interface",
					"generic",
					"strict mode",
					"tsc",
					"tsgo",
					"tsconfig",
					"typecheck",
					"compiler"
				],
				"keywordPatterns": [
					"\\btype\\b",
					"\\binterface\\b",
					"\\bgeneric\\b",
					"\\btsc\\b",
					"\\btsconfig\\b",
					"\\bts\\s?7\\b"
				],
				"pathPatterns": ["**/*.d.ts", "**/types/**", "**/types.ts", "**/tsconfig*.json"],
				"intentPatterns": [
					"(?:define|create).*(?:type|interface)",
					"(?:type).*(?:error|issue)",
					"(?:run|fix).*type.?check",
					"(?:upgrade|migrate|update).*typescript"
				],
				"contentPatterns": ["interface ", "type ", ": unknown", "as const", "compilerOptions"]
			},
			"excludePatterns": ["issue type", "type of bug"]
		},
		"ct-verification-before-completion": {
			"description": "Evidence-based completion claims protocol",
			"priority": 8,
			"triggers": {
				"keywords": ["verify", "check", "confirm", "done", "complete", "finished"],
				"intentPatterns": [
					"(?:is it|are we).*(?:done|complete|finished)",
					"(?:verify|check|confirm).*(?:works|passes)"
				],
				"contextPatterns": ["before claiming", "make sure", "double check"]
			}
		},
		"ct-code-style": {
			"description": "Code structure & style — guard clauses, lookup tables, destructuring, no magic values",
			"priority": 6,
			"triggers": {
				"keywords": [
					"refactor",
					"clean up",
					"guard clause",
					"early return",
					"destructure",
					"ternary",
					"magic number",
					"magic string",
					"lookup table",
					"arrow function"
				],
				"contentPatterns": ["else if", "else\\s*\\{", "\\bclass\\b", "this\\.", "\\bfunction\\b"],
				"intentPatterns": [
					"(?:refactor|clean up|simplify|tidy).*(?:code|function|logic)",
					"(?:extract|avoid).*(?:magic|constant|conditional)"
				]
			}
		}
	}
}
